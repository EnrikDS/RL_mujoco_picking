<mujoco model="picking_station_tool">
  <compiler angle="radian" meshdir="assets"/>

  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="collision">
      <geom group="3" rgba="0.79 0.82 0.93 1"/>
    </default>
  </default>

  <asset>
    <material name="gripper_body_mat" rgba="0.79216 0.81961 0.93333 1"/>
    <mesh name="gripper_body_mesh" file="550-00260REV02.STL"/>
  </asset>

  <worldbody>
    <body name="tool_tip_link">
      <site name="tool_tip_frame_site" type="sphere" size="0.008" rgba="0.98 0.58 0.12 1"/>
      <site name="cup_nominal_site" pos="0.5244 0 0" type="sphere" size="0.007" rgba="1 0.15 0.15 1"/>

      <body name="gripper_body_link">
        <joint
          name="cup_compliance_joint"
          type="slide"
          axis="0 -1 0"
          range="0 0.10"
          limited="true"
          stiffness="35"
          damping="1.2"
          armature="0.002"
        />
        <site name="gripper_body_frame_site" type="sphere" size="0.008" rgba="0.15 0.72 1 1"/>
        <site name="seal_tip_site" pos="0 0.5244 0" type="sphere" size="0.012" rgba="1 0.05 0.05 1"/>
        <site name="seal_axis_site" pos="0 0.5124 0" type="sphere" size="0.008" rgba="0.05 0.9 0.05 1"/>

        <geom name="gripper_body_visual" class="visual" mesh="gripper_body_mesh" material="gripper_body_mat"
          euler="-1.5707963267948966 0 -1.5707963267948966"/>

        <geom name="gripper_body_collision" class="collision" type="mesh" mesh="gripper_body_mesh"
          euler="-1.5707963267948966 0 -1.5707963267948966"/>

        <body name="cup_tip_link" pos="0.5244 0 0">
          <geom name="cup_lip_collision" class="collision" type="sphere" size="0.026" mass="0.025" rgba="1 0.78 0.1 0.45"/>
          <site name="cup_tip_site" type="sphere" size="0.008" rgba="1 0.85 0.15 1"/>

          <body name="teleop_pivot_link"/>
          <body name="gripper_tip_link"/>
        </body>

        <body name="cup_uncompressed_link" pos="0.5364 0 0">
          <site name="cup_uncompressed_site" type="sphere" size="0.006" rgba="0.1 0.95 0.5 1"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
